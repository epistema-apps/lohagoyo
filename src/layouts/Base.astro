---
import '../styles/global.css';

interface Props {
  titulo: string;
  descricao: string;
  imagem?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  /** false = página própria do profissional, sem cabeçalho/rodapé do portal. */
  moldura?: boolean;
  /** Usa o título como está (sem " · Lo Hago Yo"). */
  tituloExato?: boolean;
  corTema?: string;
}
const { titulo, descricao, imagem, jsonLd, noindex = false, moldura = true, tituloExato = false, corTema = '#1a1918' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = imagem ? new URL(imagem, Astro.site).href : new URL('/og.jpg', Astro.site).href;
const tituloCompleto = tituloExato || titulo === 'LoHagoYo.cl' ? titulo : `${titulo} · LoHagoYo.cl`;
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao.slice(0, 155)} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={moldura ? 'LoHagoYo.cl' : titulo.split(' · ')[0]} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao.slice(0, 155)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_CL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={corTema} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/atkinson-hyperlegible-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    {moldura && (
    <header class="topo">
      <div class="wrap topo-in">
        <a href="/" class="logo">
          <img src="/marca/logo.svg" alt="LoHagoYo.cl" width="168" height="35" />
        </a>
        <nav class="nav">
          <a href="/#resultados">Profesionales</a>
          <a href="/panel/" class="entrar">Entrar</a>
          <a href="/sumate/" class="btn btn-primary btn-sm">Ofrece tu servicio</a>
        </nav>
      </div>
    </header>
    )}
    <main class:list={[{ 'com-moldura': moldura }]}><slot /></main>
    {moldura && (
    <footer class="rodape">
      <div class="wrap">
        <p class="rodape-marca"><img src="/marca/logo-negativo.svg" alt="LoHagoYo.cl" width="190" height="40" loading="lazy" /></p>
        <p>Plataforma gratuita para profesionales independientes.</p>
        <p class="rodape-links">
          <a href="/sumate/">Ofrece tu servicio</a> · <a href="/panel/">Acceso profesionales</a> · <a href="/privacidad/">Privacidad</a> · <a href="/creditos/">Créditos de fotos</a>
        </p>
      </div>
    </footer>
    )}
  </body>
</html>

<style>
  .topo {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(244, 243, 240, 0.95);
    border-bottom: 1px solid var(--line);
  }
  .topo-in { display: flex; align-items: center; justify-content: space-between; min-height: 64px; gap: 12px; }
  .logo { display: block; line-height: 0; }
  .logo img { width: 168px; height: auto; }
  @media (max-width: 380px) { .logo img { width: 140px; } }
  .nav { display: flex; align-items: center; gap: 16px; }
  .nav > a:not(.btn) { color: var(--ink); text-decoration: none; font-weight: 700; }
  .btn-sm { min-height: 40px; padding: 0.45em 1em; font-size: 0.92rem; }
  .nav > a.entrar { color: var(--muted); font-weight: 400; font-size: 0.92rem; }
  .nav > a.entrar:hover { color: var(--ink); }
  .btn-sm { white-space: nowrap; }
  @media (max-width: 480px) {
    .nav > a:not(.btn):not(.entrar) { display: none; }
    .nav { gap: 12px; }
    .logo img { width: 128px; }
    .btn-sm { padding: 0.45em 0.85em; font-size: 0.86rem; }
  }
  main.com-moldura { padding-bottom: 64px; }
  main.com-moldura:has(> .sumate:last-child) { padding-bottom: 0; }
  .rodape { padding: 40px 0; background: var(--ink); color: #b9bcc3; border-top: 1px solid rgba(255,255,255,.08); }
  .rodape a { color: #fff; }
  .rodape-marca { margin-bottom: 0.8em; line-height: 0; }
  .rodape-marca img { width: 190px; height: auto; }
</style>
