---
import Base from '../layouts/Base.astro';
import TarjetaPerfil from '../components/TarjetaPerfil.astro';
import { dados } from '../dados';

const categorias = await dados.listarCategorias();
const regioes = await dados.listarRegioes();
const perfis = await dados.listarPerfisPublicos();
const itens = await Promise.all(
  perfis.map(async (perfil) => ({ perfil, servicos: await dados.listarServicosDoPerfil(perfil.id) })),
);
const comunas = [...new Set(regioes.flatMap((r) => r.comunas))].sort((a, b) => a.localeCompare(b, 'es'));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'LoHagoYo.cl',
  url: 'https://lohagoyo.cl/',
  inLanguage: 'es-CL',
};
---
<Base
  titulo="LoHagoYo.cl"
  descricao="Encuentra profesionales independientes de tu barrio en Santiago: piscinas, jardinería, limpieza y reparaciones. Contacto directo por WhatsApp, sin intermediarios."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <p class="pre">Santiago · gratis · sin intermediarios</p>
      <h1>¿Quién lo hace?<br /><span class="destaque">Lo hago yo</span><span class="ponto">.</span></h1>
      <p class="lead">Profesionales independientes de tu barrio, con contacto directo por WhatsApp.</p>

      <form id="buscar" class="busca card" role="search" onsubmit="return false">
        <label class="campo">
          <span class="sr-only">¿Qué necesitas?</span>
          <input id="q" type="search" placeholder="¿Qué necesitas? Ej: piscina, pasto, gasfiter" autocomplete="off" />
        </label>
        <label class="campo">
          <span class="sr-only">Comuna</span>
          <select id="comuna">
            <option value="">Todas las comunas</option>
            {comunas.map((c) => <option value={c}>{c}</option>)}
          </select>
        </label>
      </form>

      <nav class="cats" aria-label="Categorías">
        {categorias.map((c) => <a class="chip" href={`/servicios/${c.id}/`} data-cat={c.id}>{c.nome}</a>)}
      </nav>
    </div>
  </section>

  <section class="wrap">
    <p id="contador" class="contador" aria-live="polite">{itens.length} profesionales</p>
    <div class="grade" id="grade">
      {itens.map(({ perfil, servicos }) => <TarjetaPerfil perfil={perfil} servicos={servicos} categorias={categorias} />)}
    </div>
    <p id="vazio" class="vazio" hidden>No encontramos a nadie con esa búsqueda todavía. Prueba con otra palabra o comuna.</p>
  </section>

  <section class="wrap sumate card">
    <div>
      <h2>¿Ofreces un servicio?</h2>
      <p>Crea tu página gratis, con tus servicios, fotos y tu WhatsApp. Te damos también tu tarjeta de presentación lista para imprimir.</p>
    </div>
    <a href="/sumate/" class="btn btn-primary">Quiero mi página</a>
  </section>
</Base>

<script>
  import { normalizar } from '../dominio/formato';
  const q = document.getElementById('q') as HTMLInputElement;
  const comuna = document.getElementById('comuna') as HTMLSelectElement;
  const cards = [...document.querySelectorAll<HTMLElement>('#grade > a')];
  const contador = document.getElementById('contador')!;
  const vazio = document.getElementById('vazio')!;

  function filtrar() {
    const termos = normalizar(q.value).split(/\s+/).filter(Boolean);
    const c = normalizar(comuna.value);
    let n = 0;
    for (const card of cards) {
      const texto = card.dataset.busca ?? '';
      const comunas = (card.dataset.comunas ?? '').split('|');
      const ok = termos.every((t) => texto.includes(t)) && (!c || comunas.includes(c));
      card.hidden = !ok;
      if (ok) n++;
    }
    contador.textContent = `${n} profesional${n === 1 ? '' : 'es'}`;
    vazio.hidden = n > 0;
  }
  q.addEventListener('input', filtrar);
  comuna.addEventListener('change', filtrar);
</script>

<style>
  .hero { padding: 48px 0 32px; }
  .pre { color: var(--accent-dark); font-weight: 700; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.6em; }
  .lead { font-size: 1.2rem; color: var(--muted); max-width: 36ch; }
  .busca { display: grid; grid-template-columns: 1fr 220px; gap: 8px; padding: 8px; margin: 24px 0 16px; }
  .campo input, .campo select {
    width: 100%; min-height: 52px; padding: 0 16px; border: 1px solid var(--line); border-radius: 10px;
    font: 1rem var(--font-body); background: #fff; color: var(--ink);
  }
  @media (max-width: 640px) { .busca { grid-template-columns: 1fr; } }
  .cats { display: flex; flex-wrap: wrap; gap: 8px; }
  .contador { color: var(--muted); font-weight: 700; margin: 16px 0; }
  .grade { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; }
  .grade > [hidden] { display: none; }
  .vazio { padding: 24px; text-align: center; color: var(--muted); }
  .sumate { margin-top: 56px; padding: 28px; display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; background: var(--accent-soft); border-color: transparent; }
  .sumate h2 { margin-bottom: 0.3em; }
  .sumate p { margin: 0; max-width: 52ch; }
</style>
