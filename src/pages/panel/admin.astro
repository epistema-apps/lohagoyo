---
import Base from '../../layouts/Base.astro';
import Admin from '../../components/painel/Admin';
import { dados } from '../../dados';
import { FOTOS } from '../../dados/fotos';
import '../../styles/painel.css';

const categorias = (await dados.listarCategorias()).map((c) => ({ id: c.id, nome: c.nome, sugeridos: c.servicosSugeridos }));
const comunas = (await dados.listarRegioes()).flatMap((r) => r.comunas).sort((a, b) => a.localeCompare(b, 'es'));
const banco = Object.entries(FOTOS)
  .filter(([id]) => !id.startsWith('general'))
  .map(([id, f]) => ({ id, src: f.src, thumb: f.thumb, alt: f.alt, categoria: id.replace(/-\d+$/, '') }));
---
<Base titulo="Administración" descricao="Administración de LoHagoYo." noindex>
  <section class="wrap pn-pagina" style="max-width:960px">
    <Admin client:only="react" categorias={categorias} comunas={comunas} banco={banco} />
  </section>
</Base>
