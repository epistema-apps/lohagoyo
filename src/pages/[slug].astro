---
// Site próprio de cada profissional: parece a página dele na internet.
// O portal LoHagoYo.cl aparece só, discreto, no rodapé.
import Base from '../layouts/Base.astro';
import ServicoItem from '../components/ServicoItem.astro';
import { dados } from '../dados';
import { linkWhatsApp, textoPublico } from '../dominio/formato';
import type { Perfil } from '../dominio/tipos';

export async function getStaticPaths() {
  const perfis = await dados.listarPerfisPublicos();
  return perfis.map((perfil) => ({ params: { slug: perfil.slug }, props: { perfil } }));
}

const { perfil } = Astro.props as { perfil: Perfil };
const servicos = await dados.listarServicosDoPerfil(perfil.id);
const marca = perfil.marca ?? perfil.nomePublico;
const primeiroNome = perfil.nomePublico.split(' ')[0];
const wa = linkWhatsApp(perfil.contatos, perfil.nomePublico);
const tel = perfil.contatos.telefone?.replace(/\s/g, '');
const url = new URL(`/${perfil.slug}/`, Astro.site).href;
const capa = perfil.capa ?? perfil.fotos[0];
const cor = perfil.cor ?? '#9C7636';
const comunasTxt = perfil.comunas.length > 3
  ? `${perfil.comunas.slice(0, 3).join(', ')} y más`
  : perfil.comunas.join(', ');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: marca,
  description: perfil.apresentacao,
  url,
  ...(perfil.contatos.telefone && { telephone: perfil.contatos.telefone }),
  ...(capa && { image: new URL(capa, Astro.site).href }),
  areaServed: perfil.comunas.map((c) => ({ '@type': 'City', name: c })),
  address: { '@type': 'PostalAddress', addressRegion: 'Región Metropolitana', addressCountry: 'CL' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios',
    itemListElement: servicos.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.nome, description: s.descricao } })),
  },
};
---
<Base
  titulo={`${marca} · ${perfil.oficio} en ${perfil.comunas[0] ?? 'Santiago'}`}
  tituloExato
  descricao={`${perfil.lema ?? perfil.oficio}. ${perfil.apresentacao}`}
  imagem={capa}
  jsonLd={jsonLd}
  moldura={false}
  corTema="#15171C"
>
  <div class="sitio" style={`--cor:${cor}`}>
    <header class="cab" id="cab">
      <div class="wrap cab-in">
        <a href="#inicio" class="marca">
          <span class="mono" aria-hidden="true">{marca.charAt(0)}</span>
          <span>{marca}</span>
        </a>
        <nav class="menu" aria-label="Secciones">
          <a href="#servicios">Servicios</a>
          <a href="#sobre">Sobre mí</a>
          {perfil.fotos.length > 0 && <a href="#trabajos">Trabajos</a>}
          <a href="#contacto">Contacto</a>
        </nav>
        {wa && <a class="btn btn-wa btn-sm" href={wa} target="_blank" rel="noopener">WhatsApp</a>}
      </div>
    </header>

    <section class={`portada${capa ? '' : ' sem-foto'}`} id="inicio">
      {capa && <img class="portada-img" src={capa} alt="" fetchpriority="high" />}
      <div class="portada-filtro" aria-hidden="true"></div>
      <div class="wrap portada-in">
        <p class="sobretitulo">{perfil.oficio} · {comunasTxt}</p>
        <h1>{marca}</h1>
        {perfil.lema && <p class="lema">{perfil.lema}</p>}
        <div class="acoes">
          {wa && <a class="btn btn-wa" href={wa} target="_blank" rel="noopener">Escríbeme por WhatsApp</a>}
          <a class="btn btn-claro" href="#servicios">Ver servicios</a>
        </div>
      </div>
    </section>

    <section class="fatos">
      <div class="wrap fatos-in">
        <div><span>Atiendo</span><strong>{perfil.publicos.map(textoPublico).join(', ')}</strong></div>
        <div><span>Comunas</span><strong>{perfil.comunas.join(', ')}</strong></div>
        {perfil.horario && <div><span>Horario</span><strong>{perfil.horario}</strong></div>}
      </div>
    </section>

    <section class="wrap bloco" id="servicios">
      <p class="sobretitulo">Lo que hago</p>
      <h2>Servicios</h2>
      <div class="servicos">
        {servicos.map((s) => <ServicoItem servico={s} perfil={perfil} />)}
      </div>
    </section>

    <section class="wrap bloco sobre" id="sobre">
      {perfil.retrato && <img class="retrato" src={perfil.retrato} alt={`Foto de ${perfil.nomePublico}`} width="400" height="400" loading="lazy" />}
      <div>
        <p class="sobretitulo">Sobre mí</p>
        <h2>Hola, soy {primeiroNome}</h2>
        <p class="apres">{perfil.apresentacao}</p>
        <ul class="detalhes">
          {perfil.pagamentos.length > 0 && <li><span>Formas de pago</span>{perfil.pagamentos.join(', ')}</li>}
          <li><span>Boleta</span>{perfil.emiteBoleta ? 'Sí, emito boleta' : 'No emito boleta'}</li>
        </ul>
      </div>
    </section>

    {perfil.fotos.length > 0 && (
      <section class="wrap bloco" id="trabajos">
        <p class="sobretitulo">Trabajos</p>
        <h2>Algunos trabajos</h2>
        <div class="galeria">
          {perfil.fotos.map((f, i) => <img src={f} alt={`Trabajo ${i + 1} de ${marca}`} loading="lazy" width="600" height="400" />)}
        </div>
      </section>
    )}

    <section class="contacto" id="contacto">
      <div class="wrap contacto-in">
        <div>
          <p class="sobretitulo">Contacto</p>
          <h2>¿Conversamos?</h2>
          <p>Cuéntame qué necesitas y te respondo lo antes posible.</p>
        </div>
        <div class="contacto-acoes">
          {wa && <a class="btn btn-wa" href={wa} target="_blank" rel="noopener">WhatsApp</a>}
          {tel && <a class="btn btn-claro" href={`tel:${tel}`}>Llamar {perfil.contatos.telefone}</a>}
          {perfil.contatos.email && <a class="btn btn-claro" href={`mailto:${perfil.contatos.email}`}>{perfil.contatos.email}</a>}
        </div>
      </div>
    </section>

    <footer class="pe">
      <div class="wrap pe-in">
        <p>© {marca} · {perfil.comunas[0] ?? 'Santiago'}, Chile</p>
        <a class="plataforma" href="/" title="Página creada gratis con LoHagoYo.cl">
          <span>Página creada con</span>
          <img src="/marca/logo-negativo.svg" alt="LoHagoYo.cl" width="84" height="18" loading="lazy" />
        </a>
      </div>
    </footer>

    {wa && (
      <a class="wa-fixo btn btn-wa" href={wa} target="_blank" rel="noopener" aria-label={`Escribir a ${marca} por WhatsApp`}>WhatsApp</a>
    )}
  </div>
</Base>

<script>
  const cab = document.getElementById('cab');
  const portada = document.getElementById('inicio');
  if (cab && portada) {
    new IntersectionObserver(([e]) => cab.classList.toggle('solido', !e.isIntersecting), { rootMargin: '-72px 0px 0px 0px' }).observe(portada);
  }
</script>

<style>
  .sitio { --accent: var(--cor); --accent-dark: color-mix(in srgb, var(--cor) 85%, #000); --accent-soft: color-mix(in srgb, var(--cor) 10%, #fff); background: #fff; }
  .sobretitulo { margin: 0 0 0.6em; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-dark); }
  .btn-sm { min-height: 40px; padding: 0.45em 1.1em; font-size: 0.9rem; }
  .btn-claro { background: transparent; color: #fff; border-color: rgba(255, 255, 255, 0.5); }
  .btn-claro:hover { background: rgba(255, 255, 255, 0.1); border-color: #fff; }

  /* cabeçalho próprio: transparente sobre a portada, sólido ao rolar */
  .cab { position: fixed; inset: 0 0 auto; z-index: 30; transition: background 0.25s ease, box-shadow 0.25s ease; }
  .cab-in { display: flex; align-items: center; gap: 24px; min-height: 72px; }
  .marca { display: flex; align-items: center; gap: 12px; color: #fff; text-decoration: none; font: 700 1.1rem var(--font-head); letter-spacing: -0.02em; margin-right: auto; }
  .mono { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; border: 1.5px solid currentColor; font-size: 0.95rem; }
  .menu { display: flex; gap: 28px; }
  .menu a { color: rgba(255, 255, 255, 0.85); text-decoration: none; font-weight: 700; font-size: 0.9rem; }
  .menu a:hover { color: #fff; }
  .cab.solido { background: rgba(255, 255, 255, 0.97); box-shadow: 0 1px 0 var(--line); }
  .cab.solido .marca, .cab.solido .menu a { color: var(--ink); }
  @media (max-width: 760px) { .menu { display: none; } }

  /* portada com a foto escolhida + filtro escuro e levemente dessaturado */
  .portada { position: relative; min-height: 88svh; display: flex; align-items: flex-end; color: #fff; overflow: hidden; background: var(--ink); }
  .portada-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: saturate(0.6) contrast(1.05) brightness(0.95); }
  .portada-filtro { position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(21, 23, 28, 0.55) 0%, rgba(21, 23, 28, 0.2) 32%, rgba(21, 23, 28, 0.6) 66%, rgba(21, 23, 28, 0.92) 100%);
  }
  .sem-foto { background: radial-gradient(110% 80% at 85% 0%, #3a3e47 0%, var(--ink) 60%); }
  .portada-in { position: relative; padding-top: 120px; padding-bottom: clamp(44px, 9vh, 88px); }
  .portada .sobretitulo { color: rgba(255, 255, 255, 0.75); }
  .portada h1 { font-size: clamp(2.6rem, 9vw, 5.5rem); line-height: 1; letter-spacing: -0.045em; margin-bottom: 0.3em; max-width: 14ch; }
  .lema { font-size: clamp(1.1rem, 2.6vw, 1.4rem); max-width: 34ch; color: rgba(255, 255, 255, 0.88); margin-bottom: 1.5em; }
  .acoes { display: flex; gap: 12px; flex-wrap: wrap; }

  .fatos { background: var(--bg); border-bottom: 1px solid var(--line); }
  .fatos-in { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px 40px; padding-top: 26px; padding-bottom: 26px; }
  .fatos span, .detalhes span { display: block; font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); font-weight: 700; margin-bottom: 2px; }
  .fatos strong { font-weight: 700; }

  .bloco { padding-top: clamp(64px, 10vw, 112px); }
  .bloco h2 { font-size: clamp(1.9rem, 4.5vw, 2.7rem); margin-bottom: 0.9em; letter-spacing: -0.035em; }
  .servicos { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
  .servicos :global(.servico) { box-shadow: none; }

  .sobre { display: grid; grid-template-columns: minmax(0, 340px) 1fr; gap: clamp(24px, 6vw, 80px); align-items: center; }
  .sobre:not(:has(.retrato)) { grid-template-columns: 1fr; }
  .retrato { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 4px; filter: saturate(0.85); }
  .apres { font-size: 1.15rem; max-width: 56ch; }
  .detalhes { list-style: none; padding: 0; margin: 0; display: flex; gap: 32px; flex-wrap: wrap; }
  @media (max-width: 720px) { .sobre { grid-template-columns: 1fr; } .retrato { max-width: 280px; } }

  .galeria { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
  .galeria img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 4px; }

  .contacto { margin-top: clamp(64px, 10vw, 112px); background: var(--ink); color: #fff; }
  .contacto-in { display: flex; justify-content: space-between; align-items: center; gap: 28px; flex-wrap: wrap; padding-top: 64px; padding-bottom: 64px; }
  .contacto .sobretitulo { color: color-mix(in srgb, var(--cor) 60%, #fff); }
  .contacto h2 { font-size: clamp(1.9rem, 4.5vw, 2.7rem); margin-bottom: 0.3em; }
  .contacto p { color: rgba(255, 255, 255, 0.75); margin: 0; }
  .contacto-acoes { display: flex; gap: 12px; flex-wrap: wrap; }

  .pe { background: var(--ink); color: rgba(255, 255, 255, 0.5); border-top: 1px solid rgba(255, 255, 255, 0.08); font-size: 0.82rem; }
  .pe-in { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding-top: 20px; padding-bottom: 20px; }
  .pe p { margin: 0; }
  .plataforma { display: inline-flex; align-items: center; gap: 8px; color: inherit; text-decoration: none; opacity: 0.75; }
  .plataforma:hover { opacity: 1; }
  .plataforma img { width: 84px; height: auto; }

  /* sobre fundo escuro, o botão principal fica claro */
  .portada .btn-wa, .contacto .btn-wa { background: #fff; color: var(--ink); }
  .portada .btn-wa:hover, .contacto .btn-wa:hover { background: var(--bg); }
  .bloco, .contacto { scroll-margin-top: 72px; }
  .wa-fixo { border: 1px solid rgba(255, 255, 255, 0.25); }
  .wa-fixo { position: fixed; right: 16px; bottom: 16px; z-index: 20; box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25); }
  @media (min-width: 900px) { .wa-fixo { display: none; } }
  @media (max-width: 899px) { .pe { padding-bottom: 80px; } }
  @media (max-width: 480px) { .cab .btn-sm { display: none; } .servicos { grid-template-columns: 1fr; } }
</style>
