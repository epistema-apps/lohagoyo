---
// Site próprio de cada profissional: parece a página dele na internet.
// Referências: editorial claro, tipografia grande com ponto final, colagem de fotos
// com cantos arredondados, faixa de dados e serviços numerados.
// O portal LoHagoYo.cl aparece só, discreto, no rodapé.
import Base from '../layouts/Base.astro';
import { dados } from '../dados';
import { foto } from '../dados/fotos';
import { linkWhatsApp, textoMateriais, textoPreco, textoPublico } from '../dominio/formato';
import type { Perfil } from '../dominio/tipos';
import { readFile } from 'node:fs/promises';
import AcoesCartao from '../components/cartao/AcoesCartao';
import { desenharCartao, type DadosCartao, type EstruturaId } from '../components/cartao/desenho';
import { cartaoSvg } from '../components/cartao/render-svg';
import { criarMedidor } from '../components/cartao/gerarPdf';
import type { TemaId } from '../components/cartao/temas';

export async function getStaticPaths() {
  const perfis = await dados.listarPerfisPublicos();
  return perfis.map((perfil) => ({ params: { slug: perfil.slug }, props: { perfil } }));
}

const { perfil } = Astro.props as { perfil: Perfil };
const servicos = await dados.listarServicosDoPerfil(perfil.id);
const categoria = (await dados.listarCategorias()).find((c) => perfil.categoriaIds.includes(c.id));
const marca = perfil.marca ?? perfil.nomePublico;
const primeiroNome = perfil.nomePublico.split(' ')[0];
const wa = linkWhatsApp(perfil.contatos, perfil.nomePublico);
const tel = perfil.contatos.telefone?.replace(/\s/g, '');
const url = new URL(`/${perfil.slug}/`, Astro.site).href;
const zona = perfil.comunas.includes('Todo Santiago') ? 'Santiago' : (perfil.comunas[0] ?? 'Santiago');

// Fotos: capa + trabalhos; sem fotos, usa as da categoria.
const fotoCat = foto(categoria?.foto ?? '')?.src;
const capa = perfil.capa ?? perfil.fotos[0] ?? fotoCat;
const extras = perfil.fotos.filter((f) => f !== capa);
const iniciais = perfil.nomePublico.split(' ').filter(Boolean).slice(0, 2).map((x) => x[0]).join('').toUpperCase();
const n2 = (i: number) => String(i + 1).padStart(2, '0');

// Tarjeta escolhida no painel (padrão: Editorial Blanco), desenhada no build com as fontes reais.
const estruturaCartao = (perfil.cartao?.estrutura ?? 'editorial') as EstruturaId;
const temaCartao = (perfil.cartao?.tema ?? 'blanco') as TemaId;
const dadosCartao: DadosCartao = {
  marca, nome: perfil.nomePublico, oficio: perfil.oficio,
  telefone: perfil.contatos.telefone ?? (perfil.contatos.whatsapp ? `+${perfil.contatos.whatsapp}` : ''),
  email: perfil.contatos.email ?? '',
  comunas: perfil.comunas.includes('Todo Santiago') ? 'Todo Santiago' : perfil.comunas.slice(0, 3).join(' · '),
  url, urlCurta: `lohagoyo.cl/${perfil.slug}`,
};
const medir = await criarMedidor((c) => readFile(`public${c}`));
const svgCartao = cartaoSvg(desenharCartao(estruturaCartao, temaCartao, dadosCartao, medir, 0), `cartao-${perfil.slug}`);

const fatos = [
  { valor: String(servicos.length), rotulo: servicos.length === 1 ? 'servicio' : 'servicios' },
  perfil.comunas.length === 1
    ? { valor: perfil.comunas[0], rotulo: 'zona de atención' }
    : { valor: String(perfil.comunas.length), rotulo: 'comunas' },
  { valor: textoPublico(perfil.publicos[0] ?? 'casas').split(' ')[0], rotulo: 'atiendo principalmente' },
  { valor: perfil.emiteBoleta ? 'Sí' : 'No', rotulo: 'emito boleta' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: marca,
  description: perfil.apresentacao,
  url,
  ...(perfil.contatos.telefone && { telephone: perfil.contatos.telefone }),
  ...(capa && { image: new URL(capa, Astro.site).href }),
  areaServed: perfil.comunas.map((c) => ({ '@type': 'City', name: c })),
  address: { '@type': 'PostalAddress', addressRegion: 'Región Metropolitana', addressCountry: 'CL' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios',
    itemListElement: servicos.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.nome, description: s.descricao } })),
  },
};
---
<Base
  titulo={`${marca} · ${perfil.oficio} en ${zona}`}
  tituloExato
  descricao={`${(perfil.lema ?? perfil.oficio).replace(/[.\s]+$/, '')}. ${perfil.apresentacao}`}
  imagem={`/og/${perfil.slug}.jpg`}
  jsonLd={jsonLd}
  moldura={false}
>
  <div class="sitio">
    <header class="cab">
      <div class="wrap cab-in">
        <a href="#inicio" class="marca">{marca}<span class="ponto">.</span></a>
        <button class="menu-botao" type="button" aria-expanded="false" aria-controls="menu-secoes">
          <span class="menu-icone" aria-hidden="true"></span>Menú
        </button>
        <nav class="menu" id="menu-secoes" aria-label="Secciones">
          <a href="#servicios">Servicios</a>
          {extras.length > 0 && <a href="#trabajos">Trabajos</a>}
          <a href="#sobre">Sobre mí</a>
          <a href="#tarjeta">Mi tarjeta</a>
          <a href="#contacto">Contacto</a>
        </nav>
        {wa && <a class="wa-icone" href={wa} target="_blank" rel="noopener" aria-label={`Escribir a ${marca} por WhatsApp`}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 2.2a9.8 9.8 0 0 0-8.4 14.8L2.3 21.7l4.8-1.3A9.8 9.8 0 1 0 12 2.2z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.7 7.4c.3-.6.6-.6.9-.6h.6c.2 0 .4 0 .6.5l.8 1.9c.1.3 0 .5-.1.7l-.6.7c-.2.2-.2.4 0 .7.4.7 1 1.4 1.7 2 .7.6 1.4 1 2.1 1.3.3.1.5.1.7-.1l.7-.9c.2-.3.4-.3.7-.2l1.9.9c.3.1.4.3.4.5 0 .5-.2 1.4-1.2 1.9-.8.4-2 .5-4-.4-2.3-1-4-3.2-4.6-4.1-.7-1-1.1-2.2-.8-3.4z" fill="currentColor"/></svg></a>}
        {wa ? <a class="btn btn-escuro btn-sm" href={wa} target="_blank" rel="noopener">WhatsApp</a>
            : <a class="btn btn-escuro btn-sm sem-wa" href="#contacto">Contacto</a>}
      </div>
    </header>

    <!-- Portada -->
    <section class="hero" id="inicio">
      <div class="wrap hero-in">
        <div class="hero-txt">
          <p class="sobretitulo"><span class="traco"></span>{perfil.oficio}</p>
          <h1>{marca}<span class="ponto">.</span></h1>
          {perfil.lema && <p class="lema">{perfil.lema}</p>}
          <div class="acoes">
            {wa && <a class="btn btn-escuro" href={wa} target="_blank" rel="noopener">Escríbeme por WhatsApp</a>}
            <a class="link-seta" href="#servicios"><span aria-hidden="true">→</span> Ver servicios</a>
          </div>
          <p class="zona">{perfil.comunas.join(' · ')}</p>
        </div>
        <div class="colagem" aria-hidden={capa ? undefined : 'true'}>
          {capa && <img class="f-principal" src={capa} alt={`${perfil.oficio}, ${marca}`} fetchpriority="high" width="900" height="1100" />}
          {perfil.retrato
            ? <img class="f-sec f-pessoa" src={perfil.retrato} alt={`Foto de ${perfil.nomePublico}`} width="500" height="500" />
            : <span class="f-sec f-iniciais" aria-hidden="true">{iniciais}</span>}
          <div class="selo">
            <span>Atiendo</span>
            <strong>{perfil.publicos.map(textoPublico).join(', ')}</strong>
          </div>
        </div>
      </div>
    </section>

    <!-- Faixa de dados -->
    <section class="wrap">
      <dl class="fatos">
        {fatos.map((f) => <div><dt>{f.rotulo}</dt><dd>{f.valor}</dd></div>)}
      </dl>
    </section>

    <!-- Serviços -->
    <section class="wrap bloco" id="servicios">
      <div class="titulo">
        <p class="sobretitulo"><span class="traco"></span>Servicios</p>
        <h2>Lo que hago<span class="ponto">.</span></h2>
      </div>
      <ol class="servicos">
        {servicos.map((s, i) => {
          const mat = textoMateriais(s.preco);
          const waS = linkWhatsApp(perfil.contatos, perfil.nomePublico, s.nome);
          return (
            <li class="servico">
              <span class="num">{n2(i)}</span>
              <div class="s-corpo">
                <h3>{s.nome}</h3>
                <p class="s-desc">{s.descricao}</p>
                <div class="s-detalhes">
                  {s.incluye.length > 0 && (
                    <div><h4>Incluye</h4><ul class="inclui">{s.incluye.map((x) => <li>{x}</li>)}</ul></div>
                  )}
                  {s.temporadas.length > 0 && (
                    <div><h4>Frecuencia</h4><ul>{s.temporadas.map((t) => <li><strong>{t.frequencia}</strong><br /><span>{t.nome}</span></li>)}</ul></div>
                  )}
                  {s.extras.length > 0 && (
                    <div><h4>Adicionales</h4><ul>{s.extras.map((e) => <li>{e.nome} <span>({e.nota})</span></li>)}</ul></div>
                  )}
                </div>
              </div>
              <div class="s-lado">
                <p class="s-preco">{textoPreco(s.preco)}</p>
                {mat && <p class="s-mat">{mat}</p>}
                {waS && <a class="link-seta" href={waS} target="_blank" rel="noopener"><span aria-hidden="true">→</span> Cotizar</a>}
              </div>
            </li>
          );
        })}
      </ol>
    </section>

    <!-- Trabalhos -->
    {extras.length > 0 && (
      <section class="wrap bloco" id="trabajos">
        <div class="titulo">
          <p class="sobretitulo"><span class="traco"></span>Trabajos</p>
          <h2>Algunos trabajos<span class="ponto">.</span></h2>
        </div>
        <div class={`galeria g${Math.min(extras.length, 4)}`}>
          {extras.slice(0, 4).map((f, i) => <img src={f} alt={`Trabajo ${i + 1} de ${marca}`} loading="lazy" width="800" height="600" />)}
        </div>
      </section>
    )}

    <!-- Sobre mim -->
    <section class="wrap bloco sobre" id="sobre">
      <div class="sobre-esq">
        {perfil.retrato
          ? <img class="retrato" src={perfil.retrato} alt={`Foto de ${perfil.nomePublico}`} width="480" height="600" loading="lazy" />
          : <span class="retrato retrato-iniciais" aria-hidden="true">{iniciais}</span>}
        <p class="sobretitulo"><span class="traco"></span>Sobre mí</p>
        <h2>Hola, soy {primeiroNome}<span class="ponto">.</span></h2>
      </div>
      <div class="sobre-dir">
        <p class="apres">{perfil.apresentacao}</p>
        <dl class="detalhes">
          <div><dt>Atiendo</dt><dd>{perfil.publicos.map(textoPublico).join(', ')}</dd></div>
          <div><dt>Comunas</dt><dd>{perfil.comunas.join(', ')}</dd></div>
          {perfil.horario && <div><dt>Horario</dt><dd>{perfil.horario}</dd></div>}
          {perfil.pagamentos.length > 0 && <div><dt>Formas de pago</dt><dd>{perfil.pagamentos.join(', ')}</dd></div>}
          <div><dt>Boleta</dt><dd>{perfil.emiteBoleta ? 'Sí, emito boleta' : 'No emito boleta'}</dd></div>
        </dl>
      </div>
    </section>

    <!-- Tarjeta -->
    <section class="wrap bloco tarjeta" id="tarjeta">
      <div class="tarjeta-txt">
        <p class="sobretitulo"><span class="traco"></span>Mi tarjeta</p>
        <h2>Guarda mi contacto<span class="ponto">.</span></h2>
        <p>Escanea el código con tu celular, descárgala o compártela con quien la necesite.</p>
        <AcoesCartao client:visible dados={dadosCartao} estrutura={estruturaCartao} tema={temaCartao} />
      </div>
      <div class="tarjeta-mesa">
        <div class="tarjeta-cartao" set:html={svgCartao} role="img" aria-label={`Tarjeta de presentación de ${marca}`} />
      </div>
    </section>

    <!-- Contato -->
    <section class="wrap bloco" id="contacto">
      <div class="contacto">
        <div>
          <p class="sobretitulo claro"><span class="traco"></span>Contacto</p>
          <h2>¿Conversamos<span class="ponto">?</span></h2>
          <p>Cuéntame qué necesitas y te respondo lo antes posible.</p>
        </div>
        <div class="contacto-acoes">
          {wa && <a class="btn btn-branco" href={wa} target="_blank" rel="noopener">Escríbeme por WhatsApp</a>}
          {tel && <a class="btn btn-contorno" href={`tel:${tel}`}>Llamar {perfil.contatos.telefone}</a>}
          {perfil.contatos.email && <a class="btn btn-contorno" href={`mailto:${perfil.contatos.email}`}>{perfil.contatos.email}</a>}
          {!wa && !tel && !perfil.contatos.email && <p class="sem-contato">Datos de contacto próximamente.</p>}
        </div>
      </div>
    </section>

    <footer class="wrap pe">
      <p>© {marca} · {zona}, Chile</p>
      <div class="pe-dir">
        <a class="plataforma" href="/" title="Página creada gratis con LoHagoYo.cl">
          <span>Página creada con</span>
          <img src="/marca/logo.svg" alt="LoHagoYo.cl" width="84" height="18" loading="lazy" />
        </a>
        <a class="acesso" href="/panel/">Acceso</a>
      </div>
    </footer>

  </div>
</Base>

<script>
  const botao = document.querySelector<HTMLButtonElement>('.menu-botao');
  const menu = document.getElementById('menu-secoes');
  if (botao && menu) {
    const fechar = () => { menu.classList.remove('aberto'); botao.setAttribute('aria-expanded', 'false'); };
    botao.addEventListener('click', () => {
      const aberto = menu.classList.toggle('aberto');
      botao.setAttribute('aria-expanded', String(aberto));
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', fechar));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') fechar(); });
  }
</script>

<style>
  .sitio { background: #fff; color: var(--ink); }
  .ponto { color: var(--accent); }
  .sobretitulo { display: flex; align-items: center; gap: 12px; margin: 0 0 18px; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .traco { width: 28px; height: 1px; background: currentColor; }
  .sobretitulo.claro { color: rgba(255, 255, 255, 0.6); }

  .btn-escuro { background: var(--ink); color: #fff; }
  .btn-escuro:hover { background: #000; }
  .btn-escuro:not(.sem-wa)::before, .btn-branco::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: #25d366; }
  .btn-branco { background: #fff; color: var(--ink); }
  .btn-branco:hover { background: var(--bg); }
  .btn-contorno { color: #fff; border-color: rgba(255, 255, 255, 0.35); background: transparent; }
  .btn-contorno:hover { border-color: #fff; }
  .btn-sm { min-height: 40px; padding: 0.4em 1.1em; font-size: 0.88rem; }
  .link-seta { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-weight: 700; text-decoration: none; }
  .link-seta span { transition: transform 0.2s ease; }
  .link-seta:hover span { transform: translateX(4px); }

  /* cabeçalho */
  .cab { position: sticky; top: 0; z-index: 30; background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid transparent; }
  .cab-in { display: flex; align-items: center; gap: 24px; min-height: 76px; }
  .marca { margin-right: auto; color: var(--ink); text-decoration: none; font: 700 1.2rem var(--font-head); letter-spacing: -0.03em; }
  .menu { display: flex; align-items: center; gap: 30px; }
  .menu a { position: relative; color: var(--muted); text-decoration: none; font-size: 0.9rem; font-weight: 700; }
  .menu a + a::before { content: ''; position: absolute; left: -17px; top: 50%; width: 4px; height: 4px; border-radius: 50%; background: var(--line); }
  .menu a:hover { color: var(--ink); }
  .menu-botao { display: none; align-items: center; gap: 10px; font: 700 0.92rem var(--font-body); color: var(--ink); background: none; border: 1px solid var(--line); border-radius: 999px; padding: 8px 14px; cursor: pointer; }
  .menu-icone, .menu-icone::before, .menu-icone::after { display: block; width: 14px; height: 1.5px; background: currentColor; position: relative; transition: transform 0.2s ease; }
  .menu-icone::before, .menu-icone::after { content: ''; position: absolute; left: 0; }
  .menu-icone::before { top: -4.5px; }
  .menu-icone::after { top: 4.5px; }
  .menu-botao[aria-expanded='true'] .menu-icone { background: transparent; }
  .menu-botao[aria-expanded='true'] .menu-icone::before { transform: translateY(4.5px) rotate(45deg); }
  .menu-botao[aria-expanded='true'] .menu-icone::after { transform: translateY(-4.5px) rotate(-45deg); }
  @media (max-width: 820px) {
    .menu-botao { display: inline-flex; }
    .menu { display: none; position: absolute; left: 0; right: 0; top: 100%; flex-direction: column; align-items: stretch; gap: 0;
      background: #fff; border-bottom: 1px solid var(--line); box-shadow: 0 16px 30px rgba(21, 23, 28, 0.08); padding: 8px var(--gutter) 16px; }
    .menu.aberto { display: flex; }
    .menu a { padding: 14px 0; font-size: 1.05rem; color: var(--ink); border-bottom: 1px solid var(--line); }
    .menu a:last-child { border-bottom: 0; }
    .menu a + a::before { display: none; }
  }

  /* portada */
  .hero { background: linear-gradient(180deg, #fff 0%, var(--bg) 100%); overflow: hidden; }
  .hero-in { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; padding-top: clamp(40px, 7vw, 88px); padding-bottom: clamp(64px, 9vw, 120px); }
  .hero h1 { font-size: clamp(3rem, 8.5vw, 6.4rem); line-height: 0.95; letter-spacing: -0.055em; margin: 0 0 0.3em; }
  .lema { font-size: clamp(1.1rem, 2vw, 1.3rem); color: var(--muted); max-width: 32ch; margin-bottom: 2em; }
  .acoes { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; }
  .zona { margin: 36px 0 0; font-size: 0.86rem; color: var(--muted); letter-spacing: 0.02em; }

  .colagem { position: relative; aspect-ratio: 4 / 4.6; max-width: 560px; justify-self: end; width: 100%; }
  .f-principal { position: absolute; right: 0; top: 0; width: 82%; height: 88%; object-fit: cover; border-radius: 28px 28px 28px 120px; filter: saturate(0.8); }
  .f-sec { position: absolute; left: 0; bottom: 0; width: 42%; aspect-ratio: 1; object-fit: cover; border-radius: 24px; border: 8px solid #fff; filter: saturate(0.8); box-shadow: 0 24px 48px rgba(21, 23, 28, 0.12); }
  .f-pessoa { filter: none; object-position: center 30%; }
  .f-iniciais { display: grid; place-items: center; background: var(--ink); color: #fff; font: 700 clamp(2.4rem, 6vw, 4rem) var(--font-head); letter-spacing: -0.04em; }
  .selo { position: absolute; left: 4%; top: 10%; background: #fff; border-radius: 16px; padding: 14px 18px; box-shadow: 0 16px 40px rgba(21, 23, 28, 0.1); display: flex; flex-direction: column; max-width: 60%; }
  .selo span { font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); font-weight: 700; }
  .selo strong { font: 700 1rem var(--font-head); letter-spacing: -0.02em; }
  @media (max-width: 860px) {
    .hero-in { grid-template-columns: 1fr; }
    .colagem { justify-self: stretch; max-width: none; aspect-ratio: 4 / 3.6; }
    .f-principal { width: 86%; height: 90%; border-radius: 22px 22px 22px 80px; }
  }

  /* faixa de dados */
  .fatos { position: relative; margin: -48px 0 0; display: grid; grid-template-columns: repeat(4, 1fr); background: #fff; border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 24px 60px rgba(21, 23, 28, 0.06); }
  .fatos div { padding: 26px 28px; }
  .fatos div + div { border-left: 1px solid var(--line); }
  .fatos dt { font-size: 0.82rem; color: var(--muted); order: 2; }
  .fatos div { display: flex; flex-direction: column-reverse; gap: 4px; }
  .fatos dd { margin: 0; font: 700 clamp(1.5rem, 3.4vw, 2.3rem) var(--font-head); letter-spacing: -0.04em; color: var(--accent); line-height: 1.1; }
  @media (max-width: 760px) {
    .fatos { grid-template-columns: 1fr 1fr; }
    .fatos div:nth-child(3) { border-left: 0; }
    .fatos div:nth-child(n + 3) { border-top: 1px solid var(--line); }
    .fatos div { padding: 20px; }
  }

  .bloco { padding-top: clamp(80px, 11vw, 140px); scroll-margin-top: 60px; }
  .titulo h2, .sobre h2, .contacto h2 { font-size: clamp(2.2rem, 5.5vw, 3.6rem); line-height: 1; letter-spacing: -0.05em; margin: 0 0 0.6em; }

  /* serviços numerados */
  .servicos { list-style: none; margin: 16px 0 0; padding: 0; border-top: 1px solid var(--ink); }
  .servico { display: grid; grid-template-columns: 72px 1fr 220px; gap: 24px; padding: 36px 0; border-bottom: 1px solid var(--line); }
  .num { font: 700 0.95rem var(--font-head); color: var(--accent); padding-top: 6px; }
  .servico h3 { font-size: clamp(1.35rem, 2.6vw, 1.75rem); letter-spacing: -0.03em; margin: 0 0 8px; }
  .s-desc { color: var(--muted); max-width: 60ch; }
  .s-detalhes { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 20px 32px; margin-top: 18px; }
  .s-detalhes h4 { margin: 0 0 8px; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .s-detalhes ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; font-size: 0.95rem; }
