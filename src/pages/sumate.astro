---
import Base from '../layouts/Base.astro';
import { CONTATO, linkCadastro } from '../config';
import { foto } from '../dados/fotos';
const capa = foto('general-2')!;
---
<Base
  titulo="Ofrece tu servicio"
  descricao="Crea gratis tu página en LoHagoYo.cl: tus servicios, fotos y precios si quieres, con contacto directo por WhatsApp y tarjeta de presentación lista para imprimir."
>
  <section class="hero">
    <img src={capa.src} alt="" fetchpriority="high" />
    <div class="filtro" aria-hidden="true"></div>
    <div class="wrap hero-in">
      <p class="sobretitulo"><span></span>Para profesionales</p>
      <h1>Tu página, gratis<span class="ponto">.</span></h1>
      <p class="lead">Una página propia con tus servicios, tus fotos y tu WhatsApp. Sin comisiones y sin intermediarios: los clientes te escriben directo.</p>
      <div class="acoes">
        <a class="btn btn-branco" href="/panel/">Crear mi página</a>
        <a class="link-ajuda" href={linkCadastro()} target="_blank" rel="noopener">¿Necesitas ayuda? Escríbenos</a>
      </div>
    </div>
  </section>

  <section class="wrap bloco">
    <ol class="passos">
      <li><span>01</span><h3>Cuéntanos qué haces</h3><p>Tus servicios, cómo trabajas y, si quieres, tus precios y condiciones.</p></li>
      <li><span>02</span><h3>Sube tu foto</h3><p>Una foto tuya (obligatoria) y, si quieres, de tus trabajos. Si no tienes, eliges del banco de fotos de tu rubro.</p></li>
      <li><span>03</span><h3>Revisamos y publicamos</h3><p>Queda en <strong>lohagoyo.cl/tu-nombre</strong>, con tu tarjeta de presentación lista para imprimir.</p></li>
    </ol>
    <p class="nota">Lo haces tú mismo desde tu celular en pocos minutos. Revisamos cada página antes de publicarla. Si prefieres, te ayudamos.</p>
  </section>
</Base>

<style>
  .hero { position: relative; background: var(--ink); color: #fff; overflow: hidden; }
  .hero > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1); opacity: 0.4; }
  .filtro { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(21, 23, 28, 0.95), rgba(21, 23, 28, 0.5)); }
  .hero-in { position: relative; padding-top: clamp(64px, 11vw, 120px); padding-bottom: clamp(64px, 10vw, 112px); }
  .sobretitulo { display: flex; align-items: center; gap: 12px; margin: 0 0 18px; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255, 255, 255, 0.65); }
  .sobretitulo span { width: 28px; height: 1px; background: currentColor; }
  h1 { font-size: clamp(2.6rem, 8vw, 5rem); letter-spacing: -0.05em; line-height: 1; }
  .ponto { color: var(--sol); }
  .lead { color: rgba(255, 255, 255, 0.78); font-size: clamp(1.05rem, 2vw, 1.25rem); max-width: 44ch; margin-bottom: 2em; }
  .btn-branco { background: #fff; color: var(--ink); }
  .btn-branco:hover { background: var(--bg); }
  .bloco { padding-top: clamp(56px, 8vw, 96px); }
  .passos { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); border-top: 1px solid var(--line); }
  .passos li { padding: 28px 28px 8px 0; }
  .passos span { font: 700 0.85rem var(--font-head); color: var(--accent); }
  .passos h3 { margin: 10px 0 6px; font-size: 1.3rem; }
  .passos p { color: var(--muted); }
  .acoes { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  .link-ajuda { color: rgba(255, 255, 255, 0.8); font-weight: 700; }
  .nota { margin-top: 24px; color: var(--muted); font-size: 0.95rem; }
</style>
