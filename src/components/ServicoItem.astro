---
import type { Servico, Perfil } from '../dominio/tipos';
import { textoPreco, textoMateriais, linkWhatsApp } from '../dominio/formato';

interface Props { servico: Servico; perfil: Perfil }
const { servico, perfil } = Astro.props;
const mat = textoMateriais(servico.preco);
const wa = linkWhatsApp(perfil.contatos, perfil.nomePublico, servico.nome);
---
<article class="servico card">
  <header>
    <h3>{servico.nome}</h3>
    <p class="preco">{textoPreco(servico.preco)}</p>
  </header>
  <p>{servico.descricao}</p>
  {servico.incluye.length > 0 && (
    <>
      <p class="rotulo">Incluye</p>
      <ul class="inclui">{servico.incluye.map((i) => <li>{i}</li>)}</ul>
    </>
  )}
  {mat && <p class="mat">{mat}</p>}
  {servico.temporadas.length > 0 && (
    <>
      <p class="rotulo">Frecuencia</p>
      <ul class="temporadas">
        {servico.temporadas.map((t) => <li><strong>{t.nome}:</strong> {t.frequencia}</li>)}
      </ul>
    </>
  )}
  {servico.extras.length > 0 && (
    <>
      <p class="rotulo">Adicionales</p>
      <ul class="extras">{servico.extras.map((e) => <li>{e.nome} <span>({e.nota})</span></li>)}</ul>
    </>
  )}
  {wa && <a class="btn btn-wa" href={wa} target="_blank" rel="noopener">Cotizar por WhatsApp</a>}
</article>

<style>
  .servico { padding: 22px; display: flex; flex-direction: column; }
  header { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
  h3 { margin: 0; }
  .preco { margin: 0; font: 800 1.15rem var(--font-head); color: var(--accent-dark); white-space: nowrap; }
  .rotulo { margin: 0.6em 0 0.3em; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  ul { margin: 0 0 0.6em; padding-left: 1.2em; }
  .inclui li::marker { content: '✓  '; color: var(--ok); }
  .extras span { color: var(--muted); }
  .mat { margin: 0.4em 0; padding: 0.5em 0.8em; background: var(--bg); border-radius: 8px; font-size: 0.95rem; }
  .btn { margin-top: auto; align-self: flex-start; }
  .servico > .btn { margin-top: 12px; }
</style>
