rules_version = '2';
// Fotos do profissional: perfis/<uid>/<arquivo>. Só imagem, até 2 MB.
// Nomes permitidos: capa, retrato, trabajo-1..4 (jpg/webp/png). Leitura pública.
service firebase.storage {
  match /b/{bucket}/o {
    match /perfis/{uid}/{arquivo} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && arquivo.matches('^(capa|retrato|trabajo-[1-4])\\.(jpg|webp|png)$');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
