{
  "name": "lohagoyo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LoHagoYo.cl — plataforma gratuita de servicios de profesionales independientes.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "og": "python3 scripts/gerar-og.py",
    "build:prod": "python3 scripts/gerar-og.py && astro build",
    "publicar": "npm run build:prod && firebase deploy --only hosting --project lohagoyo-prod"
  },
  "dependencies": {
    "@astrojs/react": "7.1.8",
    "@pdf-lib/fontkit": "1.1.1",
    "astro": "7.4.11",
    "firebase": "13.3.0",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "firebase-tools": "15.36.0",
    "opentype.js": "1.3.4",
    "vitest": "5.1.0"
  }
}
